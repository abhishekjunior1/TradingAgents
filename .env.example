# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

# SEC EDGAR (US company filings, point-in-time). No key; a contact address SEC can reach you at.
#SEC_EDGAR_USER_AGENT=Your Name your@email.com

# FRED (Federal Reserve macro data). Free key: https://fred.stlouisfed.org/docs/api/api_key.html
#FRED_API_KEY=

# TypeSafe Jev: screens StockTwits and Reddit posts for the Sentiment Analyst. Optional.
#TYPESAFE_API_KEY=
#TYPESAFE_DEFAULT_MODEL=jev-latest
#TYPESAFE_BASE_URL=https://openrouter.ai/api   # Jev through OpenRouter, with an OpenRouter key above

# Custom OpenAI-compatible endpoint (vLLM, LM Studio, llama.cpp). Local servers need no key.
#OPENAI_COMPATIBLE_API_KEY=

# AWS Bedrock (pip install ".[bedrock]"). Bearer token, or the AWS credential chain; set the region either way.
#AWS_BEARER_TOKEN_BEDROCK=
#AWS_DEFAULT_REGION=us-west-2
#AWS_PROFILE=

# ChatGPT Plus or Pro plan: no key; sign in once with `tradingagents login chatgpt`.
#TRADINGAGENTS_LLM_PROVIDER=chatgpt

# Claude Pro or Max plan: no key; install Claude Code and sign in with `claude auth login`.
#TRADINGAGENTS_LLM_PROVIDER=claude_code

# Remote Ollama server. Unset uses http://localhost:11434/v1.
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# Override these DEFAULT_CONFIG keys. Provider, models, language and round counts also skip their CLI prompt.
#TRADINGAGENTS_LLM_PROVIDER=openai
#TRADINGAGENTS_DEEP_THINK_LLM=gpt-6-sol
#TRADINGAGENTS_QUICK_THINK_LLM=gpt-6-luna
# A tier on its own provider (set its model above too); its URL only for a local or relay endpoint.
#TRADINGAGENTS_DEEP_THINK_PROVIDER=
#TRADINGAGENTS_QUICK_THINK_PROVIDER=
#TRADINGAGENTS_DEEP_THINK_BACKEND_URL=
#TRADINGAGENTS_QUICK_THINK_BACKEND_URL=
#TRADINGAGENTS_LLM_BACKEND_URL=
#TRADINGAGENTS_OUTPUT_LANGUAGE=English
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
#TRADINGAGENTS_MAX_RISK_ROUNDS=1
#TRADINGAGENTS_MAX_TOOL_ROUNDS=20
#TRADINGAGENTS_CHECKPOINT_ENABLED=false

# Turn off the start-up note about a newer release and Tauric Research notices.
#TRADINGAGENTS_NO_UPDATE_CHECK=1

# Docker: a host folder for results, reports and the memory log (unset: the tradingagents_data volume).
#TRADINGAGENTS_DATA_DIR=./data

# Indian markets (docs/india.md). Bare tickers (RELIANCE) are listed on this exchange: NSE or BSE.
#TRADINGAGENTS_DEFAULT_EXCHANGE=NSE
# Example charges for NSE/BSE trades: india_equity_delivery (default), india_equity_intraday, or none.
#TRADINGAGENTS_COST_PROFILE=india_equity_delivery
# Sizing reference given with a portfolio: risk this % of the book per trade, cap a position at this %.
#TRADINGAGENTS_RISK_PER_TRADE_PCT=1.0
#TRADINGAGENTS_MAX_POSITION_PCT=20
# Watchlists for `tradingagents market --watchlist` and `backtest --watchlist` (default ~/.tradingagents/watchlists.json).
#TRADINGAGENTS_WATCHLISTS_FILE=

# Intraday (day-trader) mode (docs/intraday.md): swing (default), or intraday for a paper plan for one session.
#TRADINGAGENTS_DECISION_HORIZON=swing
# Your broker's MIS square-off for NSE/BSE, HH:MM IST: 15:10 at Upstox and Angel One, 15:12 at Zerodha and ICICI Direct (stocks with derivatives, Oct 2026).
#TRADINGAGENTS_INTRADAY_SQUARE_OFF=15:10
# Paper sizing: a notional in the listing's currency (a --portfolio wholly in that currency is used instead),
# the % of it risked per trade, and a leverage cap (1.0 is none; brokers allow up to 5x on MIS).
#TRADINGAGENTS_INTRADAY_CAPITAL=100000
#TRADINGAGENTS_INTRADAY_RISK_PCT=0.5
#TRADINGAGENTS_INTRADAY_LEVERAGE_CAP=1.0
# Example charges for NSE/BSE intraday plans: india_equity_intraday (default) or none; set your broker's rates
# per field with intraday_cost_overrides in a Python config (docs/intraday.md#charges).
#TRADINGAGENTS_INTRADAY_COST_PROFILE=india_equity_intraday
# Python for the /day-trader Claude Code skill, e.g. this repo's .venv/bin/python. Its script reads it from
# the environment, not from this file: export it before starting Claude Code.
#TRADINGAGENTS_PYTHON=

# Agent-Reach web research (docs/agent-reach.md): Exa web search, Jina Reader and YouTube through a separately
# installed agent-reach v1.6, no key needed. Off by default; install it as that page says, never from PyPI.
#TRADINGAGENTS_AGENT_REACH=1
# The agent-reach program: a path (the isolated install's folder is not on PATH), not a command line.
#TRADINGAGENTS_AGENT_REACH_COMMAND=~/.tradingagents/agent-reach/env/bin/agent-reach
# Agent-Reach's own HOME, created owner-only when missing.
#TRADINGAGENTS_AGENT_REACH_HOME=~/.tradingagents/agent-reach-home

# AlphArena paper trading (docs/arena.md): simulated money, US stocks and ETFs only, off by default.
# After a run the paper trade is shown, and sent only once you confirm (or without asking with --arena-yes).
#TRADINGAGENTS_ARENA=1
# sandbox takes an aa_test_ key (start there), live an aa_live_ key.
#TRADINGAGENTS_ARENA_MODE=sandbox
#ALPHARENA_API_KEY=
# Your AlphArena agent id, for `tradingagents arena status`.
#TRADINGAGENTS_ARENA_AGENT_ID=

# Paths and alpha benchmark. Unset uses ~/.tradingagents and the regional index.
#TRADINGAGENTS_RESULTS_DIR=
#TRADINGAGENTS_CACHE_DIR=
#TRADINGAGENTS_MEMORY_LOG_PATH=
#TRADINGAGENTS_BENCHMARK_TICKER=SPY

# Lower temperature means less run-to-run variation on models that honor it.
#TRADINGAGENTS_TEMPERATURE=0.0

# Retry budget for every LLM SDK. Raise it to ride out 429 throttling.
#TRADINGAGENTS_LLM_MAX_RETRIES=6

# Cap output tokens to bound a model that runs long and trips a timeout.
#TRADINGAGENTS_MAX_TOKENS=8192

# Reasoning depth per provider; setting one skips its prompt.
#TRADINGAGENTS_OPENAI_REASONING_EFFORT=medium
#TRADINGAGENTS_GOOGLE_THINKING_LEVEL=high
#TRADINGAGENTS_ANTHROPIC_EFFORT=high
